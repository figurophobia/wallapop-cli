# cookies.txt — paste the value of a request's "Cookie" header below, then run:
#
#     wallapop login --cookies-file cookies.txt
#
# How to get the value:
#   1. Open https://es.wallapop.com while logged in and press F12.
#   2. Go to the Network tab and pick a request to es.wallapop.com or
#      api.wallapop.com (many show up while the page loads).
#   3. Click it -> "Headers" tab.
#   4. Under "Request Headers" find "Cookie:" -> right click -> "Copy value".
#   5. Paste that value right below the dashed line (the whole
#      "name=value; name2=value2; ..." line) and save the file.
#
# Login only keeps what it needs: accessToken,
# __Secure-next-auth.session-token (the long-lived session), device_id and device_fgp.
# Never commit this file: it is git-ignored on purpose.
# ----------------------------------------------------------------------------------
device_id=REPLACE; __Secure-next-auth.session-token=REPLACE; accessToken=REPLACE; device_fgp=REPLACE
